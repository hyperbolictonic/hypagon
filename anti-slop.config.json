{
  "$schema": "./anti-slop.schema.json",
  "duplicates": {
    "src": "src",
    "minTokens": 50,
    "threshold": 3,
    "ignore": []
  },
  "modularity": {
    "src": "src",
    "maxFileLines": 500,
    "maxFunctionLines": 80,
    "maxClassMethods": 10
  },
  "docs": {
    "src": "src",
    "ignorePaths": [],
    "ignoreExports": []
  },
  "classLiterals": {
    "src": "src",
    "minOccurrences": 4
  },
  "review": {
    "enabled": true,
    "maxFiles": 5,
    "maxLines": 200,
    "riskPaths": [
      "src/main/remote/**",
      "src/main/security/**",
      "src/main/wrap/**",
      "src/main/ipc/**",
      "src/mcp/**",
      ".github/workflows/**"
    ],
    "autonomy": "ask"
  },
  "encoding": {
    "ignorePaths": []
  },
  "imports": {
    "src": "src",
    "deny": [
      { "from": "src/shared/**", "forbid": "src/main/**" },
      { "from": "src/shared/**", "forbid": "src/renderer/**" },
      { "from": "src/renderer/**", "forbid": "src/main/**" },
      { "from": "src/preload/**", "forbid": "src/main/**" },
      { "from": "src/main/**", "forbid": "src/renderer/**" }
    ]
  }
}
