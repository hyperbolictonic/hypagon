{
  "duplicates": {
    "src": "src",
    "minTokens": 50,
    "threshold": 3,
    "ignore": []
  },
  "modularity": {
    "src": "src",
    "maxFileLines": 500,
    "maxFunctionLines": 80,
    "maxClassMethods": 10
  },
  "docs": {
    "src": "src",
    "ignorePaths": [],
    "ignoreExports": []
  },
  "classLiterals": {
    "src": "src",
    "minOccurrences": 4
  },
  "encoding": {
    "ignorePaths": []
  },
  "imports": {
    "src": "src",
    "deny": [
      { "from": "src/shared/**", "forbid": "src/main/**" },
      { "from": "src/shared/**", "forbid": "src/renderer/**" },
      { "from": "src/renderer/**", "forbid": "src/main/**" },
      { "from": "src/preload/**", "forbid": "src/main/**" },
      { "from": "src/main/**", "forbid": "src/renderer/**" }
    ]
  }
}
