{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@hyperbolictonic/hypagon-browser": [
        "./packages/browser/src/index.ts"
      ],
      "@hyperbolictonic/hypagon-electron": [
        "./packages/electron/src/index.ts"
      ],
      "@hyperbolictonic/hypagon-stealth": [
        "./packages/stealth/src/index.ts"
      ],
      "@hyperbolictonic/hypagon-research": [
        "./packages/research/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
